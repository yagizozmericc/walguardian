# Guardian AI — environment template. Copy to .env.local and fill in.
# Never commit real values. All variables are server-side only.

# --- Network -----------------------------------------------------------------
# Testnet-first. "mainnet" is refused unless ALLOW_MAINNET=true, which requires
# explicit approval from the project owner.
SUI_NETWORK=testnet
ALLOW_MAINNET=

# --- Site ----------------------------------------------------------------------
# Optional public origin (e.g. a custom domain). Used for absolute Open Graph,
# canonical and sitemap URLs. On Vercel it defaults to the deployment URL;
# locally to http://localhost:3000.
SITE_URL=

# --- Tatum (Sui blockchain data) ---------------------------------------------
# Use the TESTNET API key from https://dashboard.tatum.io (free accounts include
# separate Mainnet and Testnet keys). Sent as the x-api-key gRPC metadata header.
TATUM_API_KEY=
# Optional override. Accepts host:port or https://host. Default: sui-testnet-grpc.gateway.tatum.io:443
TATUM_SUI_GRPC_ENDPOINT=
# Client-side request ceiling (requests/second) to stay under your Tatum plan limit. Default: 3
TATUM_MAX_RPS=

# --- Memory (Phase 6) ---------------------------------------------------------
# Explicit provider; no fallback between them. Unset = memory disabled (features
# that need memory report "not configured").
#   mock   = development mock (SDK MemWalMock + local git-ignored file). NOT Walrus.
#   walrus = Walrus Memory via the official SDK and a hosted relayer.
MEMORY_PROVIDER=
# Signs the anonymous session cookie that scopes memories (32+ random bytes, hex).
SESSION_SECRET=
MEMWAL_NAMESPACE_PREFIX=guardian-demo
# Memory writes. The Walrus provider is read-only unless MEMORY_WRITES_ENABLED=true, and then
# accepts only predefined structured records (no free text). Writes need Redis for quotas.
MEMORY_WRITES_ENABLED=
MEMORY_WRITES_PER_SESSION_DAY=20
MEMORY_WRITES_GLOBAL_DAY=300
# Mock provider options (local development only; disabled automatically on Vercel)
MOCK_MEMORY_FILE=.data/mock-memory.json
MOCK_MEMORY_TTL_DAYS=28
# Walrus provider: DELEGATE key (never the owner key) and MemWalAccount object ID.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Relayer. Testnet: https://relayer.dev.memwal.ai (dashboard https://dev.memwal.ai).
# Mainnet: https://relayer.memory.walrus.xyz (dashboard https://memory.walrus.xyz),
# which also needs ALLOW_WALRUS_MAINNET=true. Accounts are per network.
# The former relayer-staging.memory.walrus.xyz is retired and refused.
MEMWAL_SERVER_URL=https://relayer.dev.memwal.ai
# Any non-Testnet relayer (including Mainnet) is refused unless this is true,
# which requires the project owner's explicit approval. Separate from ALLOW_MAINNET.
ALLOW_WALRUS_MAINNET=

# --- AI copilot (Phase 7) -------------------------------------------------------
# Google Gemini API key (server-only; never exposed to the browser or logs).
# Without it the copilot returns deterministic summaries instead of AI answers.
# Free-tier note: Google may use free-tier content to improve its products —
# send only synthetic, non-sensitive data. Keep the project without billing
# to stay on the free tier.
GEMINI_API_KEY=
# Free-tier model, verified against the key's model list (2026-10-24).
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=1200
COPILOT_RATE_PER_MINUTE=6
COPILOT_RATE_PER_DAY=100

# --- Demo & limits ----------------------------------------------------------------
# Read-only demonstration wallet (public Sui Testnet address, third party by default).
DEMO_WALLET_ADDRESS=
# Per-client budget for Tatum-backed API routes. Shared across instances when Redis is
# configured (per session, and 5x per IP); per-instance otherwise.
API_RATE_PER_MINUTE=30
API_RATE_PER_DAY=2000
# --- Shared limits and caches (Upstash Redis, REST) ------------------------------
# Rate limits, write quotas, the global Tatum budget and short-lived caches. Never
# stores memory content. Keys are prefixed per environment (wg:production:, wg:preview:,
# wg:local:). Optional locally; without it, limits and caches are per process.
KV_REST_API_URL=
KV_REST_API_TOKEN=
