    "demo:protect": "tsx --conditions=react-server scripts/demo-protect.ts",
    "check:walrus": "tsx --conditions=react-server scripts/check-walrus.ts",
    "check:llm": "tsx --conditions=react-server scripts/check-llm.ts",
    "og:image": "tsx scripts/generate-og-image.tsx",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@mysten-incubation/memwal": "^0.1.9",
    "@mysten/sui": "^2.37.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
